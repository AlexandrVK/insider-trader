# --- Render: обязательно ---
ADMIN_PASSWORD=придумайте-длинный-пароль-от-12-символов
# endpoint берите из карточки бакета в Backblaze (поле Endpoint); регион должен совпадать с началом keyID (003 -> eu-central-003)
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- ИИ (по желанию): AnyModel -> Groq ---
ANYMODEL_API_KEY=
GROQ_API_KEY=

# USE_S3=auto        (auto: на Render включено, локально выключено; true/false - принудительно)
# SESSION_SECRET=    (по умолчанию выводится из ADMIN_PASSWORD)
# DATA_DIR=          (локальная папка данных, по умолчанию ./data)
