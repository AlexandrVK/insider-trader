# === Render (Web Service) + Backblaze B2 ===
# Пароль для веб-страницы статуса и отчётов (на Render обязателен >= 12 символов)
ADMIN_PASSWORD=придумайте-длинный-пароль-от-12-символов

# Backblaze B2 (на Render включаются автоматически)
USE_S3=auto
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PREFIX=crypto-bot/

# === Каскад ИИ (порядок failover: Groq -> AnyModel -> OpenRouter; без ключей работает локальный fallback) ===
GROQ_API_KEY=
ANYMODEL_API_KEY=
OPENROUTER_API_KEY=

# === Макро и уведомления (опционально) ===
FRED_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Порт HTTP-сервера (Render выставляет PORT автоматически) ===
# PORT=8080
# WEB_ENABLED=true
